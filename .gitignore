# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets — NEVER commit these
.env
.env.*
!.env.example
kaggle.json
*.kaggle/

# Data files
data/raw/*
!data/raw/.gitkeep
!data/processed/fused_sales.parquet
!data/processed/.gitkeep
!data/synthetic/*.parquet
!data/synthetic/.gitkeep

# Model artifacts
models/*.pkl
models/*.h5
models/*.pt
models/*.joblib
*.onnx

# Reports output (evaluation tables and figures tracked for instant cloning)
reports/figures/*.pdf
reports/figures/*.html
!reports/tables/*.csv
!reports/tables/.gitkeep
!reports/figures/*.png
!reports/figures/.gitkeep

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# Coverage
htmlcov/
.coverage
.coverage.*

